http-request ^https:\/\/api\.revenuecat\.com\/v1\/subscribers\/[^\/]+(\/offerings)?\/?$ requires-body=false, script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/Retouch.js, tag=Retouch-清ETag
