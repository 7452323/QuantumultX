#!name=Post Saver 保存无水印
#!desc=单纯为Post Saver导入小红书链接去水印
#!author=7452323
#!homepage=https://github.com/7452323/QuantumultX

[Rule]
# 图片 CDN 走 QUIC 会绕过 MITM
AND,((PROTOCOL,QUIC),(DOMAIN,sns-webpic-qc.xhscdn.com)),REJECT

[Script]
# 图片去水印：302 到 sns-img-bd 无水印原图
XiaohongshuImage = type=http-request,pattern=^https?://sns-webpic[a-z0-9\-]*\.xhscdn\.com/,script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/XiaohongshuImage.js
XiaohongshuVideo = type=http-response,pattern=^https://www\.xiaohongshu\.com/(?:discovery/item|explore)/,script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/XiaohongshuVideo.js,requires-body=true,max-size=-1
# 原片被 CDN 标成 application/octet-stream 时改成 video/mp4
XiaohongshuVideoType = type=http-response,pattern=^https?://sns-video-[a-z0-9\-]+\.xhscdn\.com/,script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/XiaohongshuVideoType.js

[MITM]
hostname = %APPEND% www.xiaohongshu.com, sns-webpic-qc.xhscdn.com, sns-webpic.xhscdn.com, sns-video-qc.xhscdn.com, sns-video-hw.xhscdn.com, sns-video-bd.xhscdn.com
