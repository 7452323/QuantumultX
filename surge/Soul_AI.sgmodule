# === 用户 ===
Soul_User_Detail = type=http-response,pattern=^https?:\/\/api-user\.soulapp\.cn\/(html\/user\/userDetail|user\/userDetail|user\/soulmate\/status),script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/Soul_AI.js,requires-body=true

[MITM]
hostname = %APPEND% api-chat.soulapp.cn, api-pay.soulapp.cn, api-user.soulapp.cn
