Soul_Pay_CoinDetail = type=http-response,pattern=^https?:\/\/api-pay\.soulapp\.cn\/soul\-coin\/total\-detail,script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/Soul_AI.js,requires-body=true
