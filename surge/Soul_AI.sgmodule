[Script]
# === AI 聊天特权 ===
Soul_AIGC_Privilege = type=http-response,pattern=^https?:\/\/api-chat\.soulapp\.cn\/chat\/aigc\/privilege\/info,script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/Soul_AI.js,requires-body=true
