Soul_Chat_Rounds = type=http-response,pattern=^https?:\/\/api-chat\.soulapp\.cn\/chat\/config\/rounds,script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/Soul_AI.js,requires-body=true
