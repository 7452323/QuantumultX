#!name=Scripting通知推送
#!desc=将 Surge 通知内容利用 Scripting App Remote Push 推送至 iOS 设备
#!author=7452323
#!category=通知
#!arguments=SCRIPTING_KEY:填写Token,GROUP:Surge,ICON:https://raw.githubusercontent.com/xream/scripts/main/scriptable/surge/surge-dark.png,SOUND:default,AUTO_COPY:1,LEVEL:active,VOLUME:5,IGNORE_REGEX:屏蔽通知正则
#!arguments-desc=[参数设置]\nSCRIPTING_KEY: 填入你的 Scripting Remote Push API Key\n   ├ 获取 Key：Scripting App → 工具 → Remote Push → 设置\n   └ 取值：一串 UUID\nGROUP: 指定通知的分组，默认值为 "Surge"\nICON: 自定义通知图标 URL，默认值为暗色 Surge 图标链接\nSOUND: 通知音效，默认值为 "default"\nAUTO_COPY: 自动复制通知内容到剪贴板\n   ├ 1：启用（默认值）\n   └ 0：关闭\nLEVEL: 通知时效性\n   ├ active：系统会立即亮屏显示通知（默认值）\n   ├ timeSensitive：时效性通知，可在专注状态下显示通知\n   ├ passive：仅将通知添加到通知列表，不会亮屏提醒\n   └ critical：重要通知忽略静音和勿扰模式\nVOLUME: critical 参数音量设置\n   ├ 取值：5（默认值）\n   └ 范围：1 < 10\nIGNORE_REGEX: 传入正则表达式，匹配到的通知将不会推送

[Script]
scripting_push = script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/surge/scripting/scripting_notify.js,type=event,event-name=notification,argument="SCRIPTING_KEY={{{SCRIPTING_KEY}}}&group={{{GROUP}}}&autoCopy={{{AUTO_COPY}}}&icon={{{ICON}}}&sound={{{SOUND}}}&level={{{LEVEL}}}&volume={{{VOLUME}}}&ignoreRegex={{{IGNORE_REGEX}}}"
