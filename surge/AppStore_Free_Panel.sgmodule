#!name=AppStore 限免面板
#!desc=显示 App Store 限免应用列表，支持换区。appCount=显示条数(默认8)，group=策略组名(默认Proxy)。换区: 参数改为 action=switch&region=日本 后点面板执行
#!author=7452323
#!homepage=https://github.com/7452323/QuantumultX
#!arguments=appCount:8, group:Proxy
#!arguments-desc=[显示设置]\nappCount: 显示条数，默认 8，最大 30\n\n[换区设置]\ngroup: 策略组名称，默认 Proxy\n\n换区操作：\n1. 编辑参数改为 action=switch&region=日本\n2. 点击面板执行换区\n3. 改回默认参数恢复显示

[Panel]
AppStore限免 = script-name=AppStore_Free_Panel, update-interval=600

[Script]
AppStore_Free_Panel = type=panel, script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/AppStore_Free_Panel.js, argument=appCount={{{appCount}}}&group={{{group}}}
