#!name=AppStore 限免面板
#!desc=zxki.cn 数据源 | 本体/内购限免分开显示
#!author=7452323
#!homepage=https://github.com/7452323/QuantumultX
#!arguments=appCount=8
#!arguments-desc=显示条数，默认8条，最多30条

[Panel]
限免 = script-name=AppStore_Free_Panel, update-interval=600

[Script]
AppStore_Free_Panel = type=panel, script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/AppStore_Free_Panel.js, argument=appCount=%appCount%
