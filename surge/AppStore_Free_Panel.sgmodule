#!name=AppStore 限免面板
#!desc=AppRaven 实时数据 | 本体/内购限免分开显示 | 参数编辑框实时生效
#!author=7452323
#!homepage=https://github.com/7452323/QuantumultX
#!arguments = appCount:8
#!arguments-desc = appCount:显示条数(1-30,默认8)

[Panel]
限免 = script-name=AppStore_Free_Panel, update-interval=600

[Script]
AppStore_Free_Panel = type=panel, script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/AppStore_Free_Panel.js?t=3, argument=appCount={{{appCount}}}
