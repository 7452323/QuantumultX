#!name=AppStore 限免面板
#!desc=AppRaven 限免
#!author=7452323
#!homepage=https://github.com/7452323/QuantumultX
#!arguments=appCount=8
#!arguments=region=cn
#!arguments-desc=appCount: 显示条数\nregion: App Store 地区

[Panel]
限免 = script-name=AppStore_Free_Panel, update-interval=600

[Script]
AppStore_Free_Panel = type=panel, script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/AppStore_Free_Panel.js, argument=appCount={{{appCount}}}&region={{{region}}}
