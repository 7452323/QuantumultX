#!name=AppStore 限免面板
#!desc=显示 App Store 限免应用列表，数据源: AppRaven
#!author=7452323
#!homepage=https://github.com/7452323/QuantumultX
#!arguments=appCount=8&region=cn
#!arguments-desc=📱 显示设置\nappCount: 显示条数，默认 8\nregion: App Store 地区 (cn/us/jp/kr/gb/hk/tw 等)

[Panel]
AppStore限免 = script-name=AppStore_Free_Panel, update-interval=600

[Script]
AppStore_Free_Panel = type=panel, script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/AppStore_Free_Panel.js, argument=appCount={{{appCount}}}&region={{{region}}}
