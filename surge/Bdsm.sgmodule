#!name=布丁扫描
#!desc=解锁VIP + 去广告 + 无限次数

[Script]
Bdsm = type=http-response, pattern=^https:\/\/www\.budingscan\.com\/server\/(get_user_config|payment\/(paid_modules|paid_module_used|paid_module_usage|plans|questions)|get_dynamic_config), script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/Bdsm.js, requires-body=true, max-size=-1, timeout=60
Bdsm-ad = type=http-response, pattern=^https:\/\/www\.budingscan\.com\/server\/backend\/dashboardBanner\/ online_banners, script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/Bdsm.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% www.budingscan.com
