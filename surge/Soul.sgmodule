#!name=Soul 通杀
#!desc=Soul App 超级VIP + 聊天限制全解锁
#!author=Reviewa
#!homepage=https://github.com/Reviewa/QuantumultX

[Script]
SoulSuperVIP = type=http-response,pattern=^https?://api-pay\.soulapp\.cn/(privilege/supervip/status|show/superVIP/detail/v2|soul-coin/total|soul-coin/total-detail|vip/meet/userInfo),script-path=https://raw.githubusercontent.com/Reviewa/QuantumultX/main/script/Soul.js,requires-body=true
SoulChat = type=http-response,pattern=^https?://api-chat\.soulapp\.cn/(chat/user/info|chat/session/protect/status/get|chat/aigc/privilege/info|chat/aigc/charge/page/v2|chat/limit/friendly/check|chat/limit/socialGraceScore|chat/limitInfo),script-path=https://raw.githubusercontent.com/Reviewa/QuantumultX/main/script/Soul.js,requires-body=true
SoulUser = type=http-response,pattern=^https?://api-user\.soulapp\.cn/(html/user/userDetail|user/userDetail|user/soulmate/status|user/queryInvisibleSetting),script-path=https://raw.githubusercontent.com/Reviewa/QuantumultX/main/script/Soul.js,requires-body=true
SoulMatch = type=http-response,pattern=^https?://api-a\.soulapp\.cn/(loveBell/queryMatchSpeedupConf|videoMatch/getConfig|probability/match/entrance),script-path=https://raw.githubusercontent.com/Reviewa/QuantumultX/main/script/Soul.js,requires-body=true

[MITM]
hostname = %APPEND% api-pay.soulapp.cn, api-chat.soulapp.cn, api-user.soulapp.cn, api-a.soulapp.cn
