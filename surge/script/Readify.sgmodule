#!name=Readify深读签到
#!desc=Readify深读 每日签到 — 邮箱密码SHA256登录自动刷新token
#!author=7452323
#!arguments=深读账号:--
#!arguments-desc=深读账号: 账号 email#password，多账号用 | 连接（例 a@b.com#pass1|c@d.com#pass2）；填 -- 则读持久化存储 readify_accounts

[Script]
Readify签到 = type=cron, cronexp="0 8 * * *", script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/task/Readify.js, argument=readify_accounts={{{深读账号}}}
ReadifyToken = type=http-request, pattern=^https?:\/\/readifyapp\.voiceclub\.cn\/api, script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/task/Readify.js

[MITM]
hostname = %APPEND% readifyapp.voiceclub.cn
