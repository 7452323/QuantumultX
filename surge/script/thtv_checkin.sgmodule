[Script]
thtv_checkin = type=cron,cronexp=0 10 * * *,wake-system=1,timeout=30,script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/task/thtv_checkin.js
thtv_checkin_cookie = type=http-request,pattern=^https:\/\/navix\.site\/api\/sign-in,script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/task/thtv_checkin.js,requires-body=1

[MITM]
hostname = %APPEND% navix.site
