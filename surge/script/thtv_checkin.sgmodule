#!name=探花TV签到
#!desc=探花TV论坛(navix.site)自动签到
#!author=7452323
#!category=签到
#!arguments=cron:0 10 * * *,enable_cookie:1,hostname:navix.site
#!arguments-desc=探花TV签到模块\n├ cron: 定时运行时间\n├ enable_cookie: Cookie采集开关(0关闭/1开启)\n└ hostname: MITM域名

[Script]
thtv_checkin = type=cron,cronexp="{{{cron}}}",wake-system=1,timeout=30,script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/task/thtv_checkin.js,argument="enable_cookie={{{enable_cookie}}}"
thtv_checkin_cookie = type=http-request,pattern=^https:\/\/navix\.site\/api\/sign-in,script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/task/thtv_checkin.js,requires-body=1

[MITM]
hostname = %APPEND% {{{hostname}}}
