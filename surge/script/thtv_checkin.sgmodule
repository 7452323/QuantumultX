#!name=探花TV签到
#!desc=探花TV论坛(navix.site)自动签到
#!system=Surge
#!author=7452323
#!homepage=https://github.com/7452323/QuantumultX/tree/main/surge/script

[Script]
thtv_checkin = type=cron,cronexp="0 10 * * *",timeout=30,script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/surge/script/thtv_checkin.js,script-update-interval=0
thtv_checkin_cookie = type=http-request,pattern=^https:\/\/navix\.site\/api\/sign-in,script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/surge/script/thtv_checkin.js,requires-body=true

[MITM]
hostname = %APPEND% navix.site
