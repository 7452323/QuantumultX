[Script]
txtnovel_checkin = type=cron,cronexp=%cron%,wake-system=1,timeout=30,script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/task/txtnovel_checkin.js
txtnovel_checkin_cookie = type=http-request,pattern=^http:\/\/www\.txtnovel\.vip\/plugin\.php\?id=dsu_paulsign,script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/task/txtnovel_checkin.js,requires-body=1

[MITM]
hostname = %APPEND% www.txtnovel.vip
