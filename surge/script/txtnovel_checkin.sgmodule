[Script]
txtnovel_checkin = type=cron,cronexp="0 9 * * *",timeout=30,script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/surge/script/txtnovel_checkin.js,script-update-interval=0
txtnovel_checkin_cookie = type=http-request,pattern=^http:\/\/www\.txtnovel\.vip\/plugin\.php\?id=dsu_paulsign,script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/surge/script/txtnovel_checkin.js,requires-body=true

[MITM]
hostname = %APPEND% www.txtnovel.vip
