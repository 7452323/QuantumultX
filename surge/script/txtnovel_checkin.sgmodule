#!name=书香门第签到
#!desc=www.txtnovel.vip 自动采集+签到
#!author=7452323
#!category=签到
#!arguments=cron:30 0 * * *,enable_cookie:1,hostname:www.txtnovel.vip
#!arguments-desc=书香门第签到模块\n├ cron: 定时运行时间\n├ enable_cookie: Cookie采集开关(0关闭/1开启)\n└ hostname: MITM域名

[Script]
txtnovel_checkin = type=cron,cronexp="{{{cron}}}",wake-system=1,timeout=30,script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/task/txtnovel_checkin.js,argument="enable_cookie={{{enable_cookie}}}"
txtnovel_checkin_cookie = type=http-request,pattern=^http:\/\/www\.txtnovel\.vip\/,script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/task/txtnovel_checkin.js,requires-body=1

[MITM]
hostname = %APPEND% {{{hostname}}}
