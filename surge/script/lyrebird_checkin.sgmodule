#!name=Lyrebird签到
#!desc=Lyrebird Emby 每日签到领积分
#!author=7452323
#!category=签到
#!arguments=cron:0 10 * * *,enable_cookie:1,hostname:console.lyrebirdemby.com
#!arguments-desc=Lyrebird Emby签到模块\n├ cron: 定时运行时间\n├ enable_cookie: Cookie采集开关(0关闭/1开启)\n└ hostname: MITM域名

[Script]
lyrebird_checkin = type=cron,cronexp="{{{cron}}}",wake-system=1,timeout=30,script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/task/lyrebird_checkin.js,argument="enable_cookie={{{enable_cookie}}}"
lyrebird_checkin_cookie = type=http-request,pattern=^https:\/\/console\.lyrebirdemby\.com\/api\/account\/me,script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/task/lyrebird_checkin.js,requires-body=1

[MITM]
hostname = %APPEND% {{{hostname}}}
