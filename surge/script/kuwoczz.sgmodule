#!name=酷我音乐(每日任务)
#!desc=酷我音乐每日签到 + 发评论 + 看创意视频
#!author=7452323
#!category=签到
#!arguments=cron:30 8-16/2 * * *,hostname:integralapi.kuwo.cn
#!arguments-desc=签到模块参数设置\n├ cron: 定时运行时间\n└ hostname: MITM域名

[Script]
kuwoczz = type=cron,cronexp="{{{cron}}}",wake-system=1,timeout=120,script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/task/kuwoczz.js
kuwoczz_cookie = type=http-request,pattern=^https?:\/\/integralapi\.kuwo\.cn\/api\/v1\/online\/sign\/v1\/music\/userBase,script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/task/kuwoczz.js,requires-body=1

[MITM]
hostname = %APPEND% {{{hostname}}}
