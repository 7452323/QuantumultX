[Script]
kuwo_upgrade = type=cron,cronexp="30 8 * * *",timeout=60,script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/surge/script/kuwo_checkin.js,script-update-interval=0
kuwo_upgrade_cookie = type=http-request,pattern=^https?:\/\/integralapi\.kuwo\.cn\/api\/v1\/online\/sign\/v1\/music\/userBase,script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/surge/script/kuwo_checkin.js,requires-body=true

[MITM]
hostname = %APPEND% integralapi.kuwo.cn
