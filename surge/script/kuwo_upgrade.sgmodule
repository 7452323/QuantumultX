[Script]
kuwo_upgrade = type=cron,cronexp=30 8,10,12,14,16 * * *,wake-system=1,timeout=120,script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/task/kuwo_upgrade.js
kuwo_upgrade_cookie = type=http-request,pattern=^https?:\/\/integralapi\.kuwo\.cn\/api\/v1\/online\/sign\/v1\/music\/userBase,script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/task/kuwo_upgrade.js,requires-body=1
kuwo_upgrade_webcookie = type=http-request,pattern=^https?:\/\/www\.kuwo\.cn\/,script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/task/kuwo_upgrade.js,requires-body=1

[MITM]
hostname = %APPEND% integralapi.kuwo.cn, www.kuwo.cn
