#!name=微信读书·防强更净化
#!desc=专为8.2.6等老版本微信读书设计：全面拦截改写feature、config、reconf与mobileSync响应体，彻底清空upgrade、forceUpdate、updateInfo与notice_msg等弹窗字段 — 脚本来源:TomCatXue
#!author=7452323
#!homepage=https://github.com/7452323/QuantumultX
#!icon=https://raw.githubusercontent.com/7452323/QuantumultX/main/icon/banner.png
#!tag=微信读书,防强更,去弹窗,AI听书

[Script]
WeReadEnhance = type=http-response, pattern=^https?:\/\/(i\.)?weread\.qq\.com\/(feature|config|reconf|app\/upgrade|mobileSync), script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/ReadingAd/wxread.js, requires-body=true, timeout=10

[MITM]
hostname = %APPEND% i.weread.qq.com, weread.qq.com
