[Script]
简讯VIP = type=http-response, pattern=^https:\/\/api\.tipsoon\.com\/api\/v1\/(user\/info|login\/account), script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/Jx.js, requires-body=true, max-size=-1, timeout=60
简讯去广告 = type=http-response, pattern=^https:\/\/api\.tipsoon\.com\/api\/v1\/top\/system, script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/Jx.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.tipsoon.com
