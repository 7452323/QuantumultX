#!name=TXT to EPUB 全能解锁
#!desc=拦截 Apple verifyReceipt / StoreKit API / RevenueCat 订阅验证
#!author=7452323

[Script]
TxtToEpub = type=http-response, pattern=^https://(buy\.itunes\.apple\.com/verifyReceipt|api\.storekit(-sandbox)?\.itunes\.apple\.com/inApps/v1/verifyReceipt|api\.(rc-backup|revenuecat)\.com/v1/subscribers/), script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/TxtToEpub.js, requires-body=true, max-size=-1

[MITM]
hostname = %APPEND% buy.itunes.apple.com, api.storekit.itunes.apple.com, api.storekit-sandbox.itunes.apple.com, api.rc-backup.com, api.revenuecat.com
