[Script]
http-response ^https?:\/\/api\.account\.meitu\.com\/(users\/show_current|common\/check_device_login_pwd_list) requires-body=true, script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/MeiYanXiagJi.js, tag=美颜相机-账号会员
http-response ^https?:\/\/vesdk\.meitu\.com\/subscribe\/func_limit_batch_query requires-body=true, script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/MeiYanXiagJi.js, tag=美颜相机-功能限额
http-response ^https?:\/\/(api\.meiyan\.com|api-tool-meiyan\.meituyun\.com)\/vip\/(user_info|user_center|user_subscription_info|center_module) requires-body=true, script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/MeiYanXiagJi.js, tag=美颜相机-会员中心

[MITM]
hostname = %APPEND% api.account.meitu.com, vesdk.meitu.com, api.meiyan.com, api-tool-meiyan.meituyun.com
