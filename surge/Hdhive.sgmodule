#!name=影巢签到
#!desc=HDHive 影巢多账号自动签到（Next.js动态追踪+POST登录）
#!author=7452323
#!arguments=hdhive_accounts=
#!arguments=hdhive_next_action=
#!arguments-desc=hdhive_accounts: 账号格式 user#pass 或 user#pass#cookie，多账号用 ; 分隔\nhdhive_next_action: 留空自动扫描

[Script]
影巢签到 = type=cron, cronexp="30 8 * * *", script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/task/Hdhive.js, argument=hdhive_accounts={{{hdhive_accounts}}}&hdhive_next_action={{{hdhive_next_action}}}
影巢Cookie = type=http-request, pattern=^https?:\/\/hdhive\.com\/api\/customer\/user\/checkin, script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/task/Hdhive.js

[MITM]
hostname = hdhive.com
