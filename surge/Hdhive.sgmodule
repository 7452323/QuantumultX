#!name=RE0 每日签到
#!desc=RE0(re0.me，原HDHive影巢) 每日签到 — Next.js Server Action 协议（免 X-HDH 签名）v2.0.1
#!author=7452323
#!arguments=re0_accounts=
#!arguments-desc=re0_accounts: 账号 user#pass，多账号用 %26 连接（例 a#1%26b#2）；留空则读持久化存储 re0_accounts

[Script]
RE0签到 = type=cron, cronexp="20 0 * * *", script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/task/Hdhive.js, argument=re0_accounts={{{re0_accounts}}}
RE0Cookie = type=http-request, pattern=^https?:\/\/re0\.me, script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/task/Hdhive.js

[MITM]
hostname = %APPEND% re0.me
