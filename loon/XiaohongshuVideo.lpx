#!name=Post Saver 保存无水印
#!desc=单纯为Post Saver导入小红书链接去水印
#!author=7452323
#!homepage=https://github.com/7452323/QuantumultX

[Rule]
# 图片 CDN 走 QUIC 会绕过 MITM，重定向就不生效
AND,((protocol,quic),(domain,sns-webpic-qc.xhscdn.com)),REJECT

[Script]
# 图片：只给 App 的保存下载 302 无水印原图；界面显示(WKWebView 增量加载, priority 带 i)放过拿 56KB 缩略图
# 302 目标保留 <日期>/<hash>/ 之后的整条尾巴 —— notes_pre_post/ 前缀剥了必 404（单图空白、多图带水印）
http-request ^https?://sns-webpic[a-z0-9\-]*\.xhscdn\.com/ script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/XiaohongshuImage.js, tag=XiaohongshuImage
http-response ^https://www\.xiaohongshu\.com/(?:discovery/item|explore)/ script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/XiaohongshuVideo.js, requires-body=true, tag=XiaohongshuVideo
# 有的原片被 CDN 标成 application/octet-stream，播放器会当"链接过期"处理
http-response ^https?://sns-video-[a-z0-9\-]+\.xhscdn\.com/ script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/XiaohongshuVideoType.js, tag=XiaohongshuVideoType

[MITM]
hostname = www.xiaohongshu.com, sns-webpic-qc.xhscdn.com, sns-webpic.xhscdn.com, sns-video-qc.xhscdn.com, sns-video-hw.xhscdn.com, sns-video-bd.xhscdn.com
