#!name=Post Saver 受限内容修复
#!desc=修复 Post Saver 保存推特/Instagram 受限内容失败
#!author=7452323
#!homepage=https://github.com/7452323/QuantumultX

[Rule]
# QUIC 会绕过 MITM
AND,((protocol,quic),(domain,cdn.syndication.twimg.com)),REJECT
AND,((protocol,quic),(domain,www.instagram.com)),REJECT

[Script]
# 推特：syndication 返回 TweetTombstone 时用 fxtwitter 重建
http-response ^https://cdn\.syndication\.twimg\.com/tweet-result script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/TwitterRestricted.js, requires-body=true, max-size=-1, tag=TwitterRestricted
# Instagram：embed 被判 invalid 时用登录会话重取，再以主站 og 兜底
http-response ^https://www\.instagram\.com/.*/embed/ script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/InstagramRestricted.js, requires-body=true, max-size=-1, tag=InstagramRestricted

[MITM]
hostname = cdn.syndication.twimg.com, www.instagram.com
