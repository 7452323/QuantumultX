[Script]
http-request ^https:\/\/api\.revenuecat\.com\/v1\/subscribers\/[^\/]+(\/offerings)?\/?$ script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/Retouch.js, requires-body=false, tag=Retouch-清ETag
