#!name = 微信读书·全功能自动化
#!desc = 微信读书 每日阅读领卡+周二翻牌抽奖+周五限免入架 — 脚本来源:TomCatXue，凭据自动捕获，401自动脱机换票
#!author = 7452323
#!homepage = https://github.com/7452323/QuantumultX
#!icon = https://raw.githubusercontent.com/7452323/QuantumultX/main/icon/banner.png
#!tag = 微信读书,签到,翻牌,限免

[Argument]
weread = switch,true,tag=微信读书,desc=包含全量凭据捕获、每日签到、周二翻牌抽奖、周五限免好书入架

[Script]
# 凭据捕获层
request if ${url} ~= /^https?:\/\/(i\.)?weread\.qq\.com\/(flip-card-game|user\/|feature|free\/library|checkfreequalify)/i then script("https://raw.githubusercontent.com/7452323/QuantumultX/main/task/Reading/weread_cookie.js") with enable=${weread}, tag="微信读书·凭据捕获"
request if ${url} ~= /^https?:\/\/i\.weread\.qq\.com\/login/i then script("https://raw.githubusercontent.com/7452323/QuantumultX/main/task/Reading/weread_cookie.js") with enable=${weread}, tag="微信读书·登录请求", requires_body=true
response if ${url} ~= /^https?:\/\/i\.weread\.qq\.com\/login/i then script("https://raw.githubusercontent.com/7452323/QuantumultX/main/task/Reading/weread_cookie.js") with enable=${weread}, tag="微信读书·登录响应", requires_body=true

# 定时执行层
cron "0 23 * * *" then script("https://raw.githubusercontent.com/7452323/QuantumultX/main/task/Reading/weread_claim.js") with enable=${weread}, tag="微信读书·每日阅读奖励"
cron "0 20 * * 2" then script("https://raw.githubusercontent.com/7452323/QuantumultX/main/task/Reading/weread_flip.js") with enable=${weread}, tag="微信读书·周二翻牌抽奖"
cron "0 10 * * 5" then script("https://raw.githubusercontent.com/7452323/QuantumultX/main/task/Reading/weread_free.js") with enable=${weread}, tag="微信读书·每周限免入架"

[MITM]
hostname = weread.qq.com, i.weread.qq.com
