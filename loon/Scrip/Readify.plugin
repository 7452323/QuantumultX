[Script]
http-request ^https?:\/\/readifyapp\.voiceclub\.cn\/api script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/task/Readify.js, tag=ReadifyToken, require-body=false
cron "0 8 * * *" script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/task/Readify.js, tag=Readify签到

[MITM]
hostname = readifyapp.voiceclub.cn
