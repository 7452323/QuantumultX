#!name=Readify深读签到
#!desc=Readify深读 每日签到 — 邮箱密码SHA256登录自动刷新token，每轮第7天自动领取奖励
#!author=7452323
#!homepage=https://github.com/7452323/QuantumultX
#!tag=Readify,深读,签到,领奖

[Argument]
readify_accounts = input, "--", tag = 深读账号, desc = 账号 email#password，多账号用 | 连接（例 a@b.com#pass1|c@d.com#pass2）；填 -- 则读持久化存储 readify_accounts

[Script]
http-request ^https?:\/\/readifyapp\.voiceclub\.cn\/api script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/task/Readify.js, tag=ReadifyToken, require-body=false
cron "0 8 * * *" script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/task/Readify.js, argument="readify_accounts=${readify_accounts}", tag=Readify签到

[MITM]
hostname = readifyapp.voiceclub.cn
