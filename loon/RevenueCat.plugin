[Script]
http-response ^https:\/\/([a-z0-9-]+\.)*revenuecat.com\/(v[12]\/)?(receipts|subscribers\/.+) script-path=https://raw.githubusercontent.com/Reviewa/QuantumultX/main/script/RevenueCat.js, requires-body=true, tag=RevenueCat通杀

[MITM]
hostname = *.revenuecat.com
