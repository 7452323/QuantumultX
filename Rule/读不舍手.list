# 读不舍手 — Quantumult X 配置
# 复制到 [rewrite_remote] 或粘贴到 [rewrite_local]

# ==================== RevenueCat 解锁 ====================
# 请求阶段 — 剥离缓存头强制服务端返回完整 200 响应
^https:\/\/(api\.rc-backup\.com|api\.revenuecat\.com)\/v1\/(subscribers|offerings) url script-request-header dubusheshou_qx.js

# 响应阶段 — 修改订阅数据
^https:\/\/(api\.rc-backup\.com|api\.revenuecat\.com)\/v1\/(subscribers|offerings) url script-response-body dubusheshou_qx.js

# ==================== 去广告 ====================
# 穿山甲 SDK
^https:\/\/.+\.pangolin-sdk-toutiao\.com url reject
^https:\/\/.+\.pglstatp-toutiao\.com url reject
^https:\/\/.+\.pglstatp-toutiao\.com\/obj\/ url reject
^https:\/\/.+\.gromore\.(?:cn|com) url reject
^https:\/\/.+\.volces\.com url reject
^https:\/\/.+\.ctobsnssdk\.com url reject
^https:\/\/mssdk\.volces\.com url reject

# 快手广告
^https:\/\/gdfp\.gifshow\.com url reject
^https:\/\/open\.e\.kuaishou\.com url reject

# 腾讯广告
^https:\/\/sdk\.e\.qq\.com url reject
^https:\/\/tdid\.m\.qq\.com url reject

# 其他
^https:\/\/i\.gtimg\.cn url reject
^https:\/\/api-access\.pangolin-sdk-toutiao1\.com url reject
^https:\/\/api\.lzfuture\.com url reject

# ==================== MITM ====================
# [MITM]
