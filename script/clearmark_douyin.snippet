#!name=抖音去水印 ClearMark
#!desc=抖音视频无水印 + 下载解锁 + 画质增强。基于2026新版API: watermark=1→0 + has_watermark=false。安装后请清除抖音缓存或重装。
#!author=宝宝
#!homepage=https://github.com/7452323/QuantumultX
#!icon=https://raw.githubusercontent.com/7452323/ClearMark/main/icon.png
#!raw-url=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/clearmark_douyin.snippet
#!date=2026-05-29

#############################################
# 🐣 ClearMark 抖音去水印 v2
# 原理: 拦截 API 响应 → watermark=1→0 → has_watermark=false
#############################################

# 📺 视频详情 (Web)
^https?:\/\/[\w-]+\.douyin\.com\/aweme\/v1\/web\/aweme\/detail\/ url script-response-body clearmark_douyin.js

# 📺 视频详情 (App)
^https?:\/\/[\w-]+\.(douyin|iesdouyin|snssdk)\.com\/aweme\/v1\/aweme\/detail\/ url script-response-body clearmark_douyin.js

# 📱 Feed流 (Web + App)
^https?:\/\/[\w-]+\.(douyin|iesdouyin|snssdk)\.com\/aweme\/v1\/(web\/)?(feed|follow\/feed|homepage\/feed|recommend\/feed|nearby\/feed)\/ url script-response-body clearmark_douyin.js

# 🔍 搜索
^https?:\/\/[\w-]+\.(douyin|iesdouyin|snssdk)\.com\/aweme\/v1\/(web\/)?(search|general\/search)\/ url script-response-body clearmark_douyin.js

# 👤 用户主页
^https?:\/\/[\w-]+\.(douyin|iesdouyin|snssdk)\.com\/aweme\/v1\/web\/profile\/(post|like|collect)\/ url script-response-body clearmark_douyin.js

# 🖼️ 图文笔记
^https?:\/\/[\w-]+\.(douyin|iesdouyin|snssdk)\.com\/aweme\/v1\/(web\/)?note\/ url script-response-body clearmark_douyin.js

# 🎬 视频播放/下载 (Play URL)
^https?:\/\/[\w-]+\.(douyin|iesdouyin|snssdk)\.com\/aweme\/v1\/play\/ url script-response-body clearmark_douyin.js

# 🌐 host 拦截
host, *.ad.xiaoshua.com, reject
host, *.ads.douyin.com, reject

# ===== hostname =====
hostname = *.douyin.com, *.iesdouyin.com, *.snssdk.com, *.ad.xiaoshua.com
