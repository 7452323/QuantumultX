# 🚫 广告拦截
^https?:\\/\\/[\w-]+\\.(douyin|iesdouyin)\\.com\\/aweme\\/v1\\/web\\/ad\\/ url reject
^https?:\\/\\/[\w-]+\\.(douyin|iesdouyin)\\.com\\/aweme\\/v1\\/web\\/advertiser url reject
^https?:\\/\\/[\w-]+\\.(douyin|iesdouyin)\\.com\\/aweme\\/v1\\/web\\/live\\/ad url reject

# 🌐 host 拦截
host, *.ad.xiaoshua.com, reject
host, *.ad.douyin.com, reject
host, *.ads.cn, reject
host, *.ads.douyin.com, reject

# ===== hostname =====
hostname = *.douyin.com, *.iesdouyin.com, *.ad.xiaoshua.com, *.ads.cn
