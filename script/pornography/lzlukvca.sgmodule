#!name=黄豆短剧 lzlukvca 协议诊断（只读）
#!desc=解密 lzlukvca.cc 的 /api/drama/detail 与 /api/drama/play 加密请求/响应并在控制台输出诊断日志。
#!system=ios
#!author=7452323
#!homepage=https://github.com/7452323/QuantumultX

[Script]
lzlukvca-req = type=http-request, pattern=^https://lzlukvca\.cc/api/drama/(detail|play), requires-body=true, binary-body-mode=true, script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/pornography/lzlukvca.js
lzlukvca-resp = type=http-response, pattern=^https://lzlukvca\.cc/api/drama/(detail|play), requires-body=true, binary-body-mode=true, script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/pornography/lzlukvca.js

[MITM]
hostname = %APPEND% lzlukvca.cc
