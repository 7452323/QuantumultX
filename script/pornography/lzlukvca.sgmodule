#!name=黄豆短剧 解锁（v3）
#!desc=客户端解锁：会员身份 + 无限金币 + 全剧集解锁 + 去广告。付费集正片受服务端硬闸门限制，回退为试看片（可用 argument 关闭）。
#!system=ios
#!author=7452323
#!homepage=https://github.com/7452323/QuantumultX
#!arguments=付费集降级:true,去广告:true,会员显示:true,调试日志:false
#!arguments-desc=付费集降级 付费集退化为试看片 / 去广告 去掉推广位 / 会员显示 显示会员标识 / 调试日志 输出调试日志

[Script]
hdmgdj-req = type=http-request, pattern="^https?://([a-z0-9-]+\.)*(hddj34\.com|hddj35\.com|hddj36\.com|hddj37\.com|hddj38\.com|hddj39\.com|hddj40\.com|cocoaview\.cc|jaorexkn\.cc|duynmkkc\.cc|qoyetjob\.cc|djxlqqzc\.cc|vtqzwlyffd\.cc|bikhonslkt\.cc|mclkhiskya\.cc|nejkvzhgnd\.cc|riomxqmm\.cc|bqklinuv\.cc|flkuoiqj\.cc|rsbzjnyq\.cc|whehmjxx\.cc|bpmndclb\.cc|kzuztchn\.cc|yyhdqbdl\.cc|puebfphy\.cc|zxgfptwc\.cc|ygeucnff\.cc|jhbnaxrk\.cc)/api/drama/play$", requires-body=1, binary-body-mode=1, max-size=-1, timeout=30, script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/pornography/lzlukvca.js, argument=previewFallback={{付费集降级}},stripAds={{去广告}},fakeVip={{会员显示}},debug={{调试日志}}
hdmgdj-resp = type=http-response, pattern="^https?://([a-z0-9-]+\.)*(hddj34\.com|hddj35\.com|hddj36\.com|hddj37\.com|hddj38\.com|hddj39\.com|hddj40\.com|cocoaview\.cc|jaorexkn\.cc|duynmkkc\.cc|qoyetjob\.cc|djxlqqzc\.cc|vtqzwlyffd\.cc|bikhonslkt\.cc|mclkhiskya\.cc|nejkvzhgnd\.cc|riomxqmm\.cc|bqklinuv\.cc|flkuoiqj\.cc|rsbzjnyq\.cc|whehmjxx\.cc|bpmndclb\.cc|kzuztchn\.cc|yyhdqbdl\.cc|puebfphy\.cc|zxgfptwc\.cc|ygeucnff\.cc|jhbnaxrk\.cc)/api/(drama/(play|doBuy|detail|navBlock|navFilter|searchResult|more|rank|list|navList|limitedFree|updateCenter|topicDetail|topicList|favorite|love|wish)|movie/(navBlock|navFilter|detail|favorite|love|history)|user/(info|home|vip|favorite)|up/(episodePreview|bannerList|episodeFeed|recommend|home|content|episodeList|detail)|system/info|ad/policy|search/movie)$", requires-body=1, binary-body-mode=1, max-size=-1, timeout=30, script-path=https://raw.githubusercontent.com/7452323/QuantumultX/main/script/pornography/lzlukvca.js, argument=previewFallback={{付费集降级}},stripAds={{去广告}},fakeVip={{会员显示}},debug={{调试日志}}

[MITM]
hostname = %APPEND% hddj34.com, *.hddj34.com, hddj35.com, *.hddj35.com, hddj36.com, *.hddj36.com, hddj37.com, *.hddj37.com, hddj38.com, *.hddj38.com, hddj39.com, *.hddj39.com, hddj40.com, *.hddj40.com, cocoaview.cc, *.cocoaview.cc, jaorexkn.cc, *.jaorexkn.cc, duynmkkc.cc, *.duynmkkc.cc, qoyetjob.cc, *.qoyetjob.cc, djxlqqzc.cc, *.djxlqqzc.cc, vtqzwlyffd.cc, *.vtqzwlyffd.cc, bikhonslkt.cc, *.bikhonslkt.cc, mclkhiskya.cc, *.mclkhiskya.cc, nejkvzhgnd.cc, *.nejkvzhgnd.cc, riomxqmm.cc, *.riomxqmm.cc, bqklinuv.cc, *.bqklinuv.cc, flkuoiqj.cc, *.flkuoiqj.cc, rsbzjnyq.cc, *.rsbzjnyq.cc, whehmjxx.cc, *.whehmjxx.cc, bpmndclb.cc, *.bpmndclb.cc, kzuztchn.cc, *.kzuztchn.cc, yyhdqbdl.cc, *.yyhdqbdl.cc, puebfphy.cc, *.puebfphy.cc, zxgfptwc.cc, *.zxgfptwc.cc, ygeucnff.cc, *.ygeucnff.cc, jhbnaxrk.cc, *.jhbnaxrk.cc
