# 黄豆短剧 lzlukvca 金币剧集解锁 —— Quantumult X 配置
# 脚本远程地址（更新源，.js 文件）:
#   https://raw.githubusercontent.com/7452323/QuantumultX/main/script/pornography/lzlukvca.js
# 使用方法：
#   1. 把上面的 lzlukvca.js 下载到 Quantumult X 的 Scripts 目录（iCloud Drive/Quantumult X/Scripts/），文件名保持 lzlukvca.js
#   2. 把下面 [rewrite_local] 与 [mitm] 两段合并进自己的 Quantumult X 配置
#   3. 开启「MitM」并安装/信任证书
# 说明：
#   - detail 响应：全部剧集改写为已解锁（免费剧保持 type=free，付费剧改 type=coin / is_buy=true / price=0 / coin_episodes 清空 / is_buy_whole=true）
#   - play 响应：813004(VIP会员)/813005(金币)/813006(其它付费) 时伪造成功响应（status=y + 真实 hls_key），金币/会员剧集可直接播放
#   - 其余流量原样放行
#   - 二进制 body 在 QX 中为 base64 字符串，脚本会自动解码

[rewrite_local]
^https://lzlukvca\.cc/api/drama/(detail|play) url script-request-body lzlukvca.js
^https://lzlukvca\.cc/api/drama/(detail|play) url script-response-body lzlukvca.js

[mitm]
hostname = lzlukvca.cc
